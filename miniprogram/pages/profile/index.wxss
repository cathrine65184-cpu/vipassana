.user { display: flex; align-items: center; gap: 28rpx; }
.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: var(--gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-img { width: 84rpx; height: 84rpx; }
.user-info { flex: 1; }
.user-name { font-size: 34rpx; font-weight: 600; display: flex; align-items: center; gap: 10rpx; }
.user-level { display: flex; align-items: center; gap: 16rpx; margin-top: 10rpx; }
.level-tag {
  background: var(--forest);
  color: #F7F4EE;
  font-size: 21rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}
.level-bar {
  margin-top: 16rpx;
  height: 8rpx;
  background: var(--line);
  border-radius: 999rpx;
  overflow: hidden;
}
.level-in { height: 100%; background: var(--gold); border-radius: 999rpx; }

.vip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(120deg, var(--card) 30%, var(--gold-soft) 100%);
}
.vip-title { font-size: 32rpx; color: var(--gold); }
.vip-sub { font-size: 23rpx; color: var(--ink-3); margin-top: 6rpx; }

.overview { display: flex; justify-content: space-around; }
.ov { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.ov-num { font-size: 44rpx; font-weight: 700; }

.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40rpx 16rpx; }
.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  position: relative;
}
.grid-count { font-size: 20rpx; color: var(--ink-3); }

.list { padding: 8rpx 32rpx; }
.li {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.list .li:last-child { border-bottom: none; }
.li-label { flex: 1; font-size: 28rpx; }
