.a-head {
  border-radius: var(--radius);
  padding: 64rpx 44rpx;
  color: #FAF8F2;
  margin-bottom: 24rpx;
}
.a-title { font-size: 46rpx; }
.a-sub { margin-top: 14rpx; font-size: 25rpx; opacity: 0.78; line-height: 1.7; }

.a-body { padding: 40rpx 36rpx; }

.b-h {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 31rpx;
  font-weight: 700;
  margin: 44rpx 0 8rpx;
}
.b-h:first-child { margin-top: 0; }
.b-h-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: var(--gold);
  flex-shrink: 0;
}

.b-p {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 2;
  color: var(--ink-2);
  text-align: justify;
}

.b-li {
  display: flex;
  gap: 18rpx;
  margin-top: 26rpx;
}
.b-li-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--sage);
  margin-top: 20rpx;
  flex-shrink: 0;
}
.b-li-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 2;
  color: var(--ink-2);
  text-align: justify;
}
.b-li-term { font-weight: 700; color: var(--ink); }

.b-tip {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
  background: var(--gold-soft);
  border-radius: var(--radius-sm);
  padding: 28rpx;
  font-size: 26rpx;
  line-height: 1.9;
  color: var(--ink-2);
}
