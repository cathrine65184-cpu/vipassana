<view class="home">

  <!-- ================= Hero（设计稿同款：照片 + 暗色渐变） ================= -->
  <view class="hero">
    <image class="hero-photo" src="{{heroImg}}" mode="aspectFill" />
    <view class="hero-shade"></view>

    <view class="hero-content" style="padding-top:{{statusBar + 16}}px;">
      <!-- 左上品牌 -->
      <view class="hero-brand">
        <view class="hero-brand-name">VIPASSANA</view>
        <view class="hero-brand-sub">内观 · 觉知 · 正念 · 自由</view>
      </view>

      <!-- 中央标识 -->
      <view class="hero-center">
        <image class="hero-logo" src="/assets/logo-white.png" mode="aspectFit" bindtap="goSilent" />
        <view class="hero-slogan display">应无所住</view>
        <view class="hero-en">it is what it is</view>
      </view>

      <!-- 四支柱速览（毛玻璃卡 + 圆形图标） -->
      <view class="glass pillars-quick">
        <view
          wx:for="{{pillars}}"
          wx:key="id"
          class="quick"
          data-id="{{item.id}}"
          bindtap="scrollToPillar"
        >
          <view class="quick-ring">
            <van-icon name="{{item.icon}}" size="40rpx" color="#F7F4EE" />
          </view>
          <text class="quick-label">{{item.title}}</text>
        </view>
      </view>

      <!-- 禅语轮播（毛玻璃卡 + 三圆点） -->
      <view class="glass quote-glass">
        <view class="quote-mark display qm-l">“</view>
        <swiper class="quote-swiper" autoplay interval="6000" circular bindchange="onQuoteSwipe">
          <swiper-item wx:for="{{heroQuotes}}" wx:key="text">
            <view class="quote-slide">
              <view class="quote-text">{{item.text}}</view>
            </view>
          </swiper-item>
        </swiper>
        <view class="quote-mark display qm-r">”</view>
        <view class="quote-dots">
          <view wx:for="{{heroQuotes}}" wx:key="text" class="qdot {{quoteIndex === index ? 'on' : ''}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- ================= 内容区 ================= -->
  <view class="body">

    <block wx:if="{{loading}}">
      <view class="skeleton sk-md"></view>
      <view class="skeleton sk-lg"></view>
      <view class="skeleton sk-md"></view>
    </block>

    <block wx:else>
      <!-- 今日冥想 -->
      <section-title title="今日冥想" sub="Today's Meditation" more="全部" bind:more="goMeditationTab" />
      <view class="card continue-card fade-item" bindtap="goContinue">
        <view class="continue-cover cover {{continueItem.cover}}">
          <image class="cover-img" src="{{continueItem.img}}" mode="aspectFill" />
          <van-icon name="play-circle-o" color="#F7F4EE" size="64rpx" class="cover-play" />
        </view>
        <view class="continue-info">
          <view class="t-title">{{continueItem.title}}</view>
          <view class="t-hint">{{continueItem.minutes}} 分钟 · {{continueItem.category}}</view>
          <view class="continue-btn">继续聆听</view>
        </view>
      </view>

      <!-- 四大支柱详情卡 -->
      <section-title title="四大支柱" sub="The Four Pillars" />
      <view class="pillars">
        <view
          wx:for="{{pillars}}"
          wx:key="id"
          id="pillar-{{item.id}}"
          class="pillar card fade-item"
        >
          <view class="pillar-head">
            <view class="pillar-badge {{item.cover}}">
              <van-icon name="{{item.icon}}" color="#F7F4EE" size="36rpx" />
            </view>
            <view class="pillar-name">
              <text class="display pillar-title">{{item.title}}</text>
              <text class="pillar-en">{{item.en}}</text>
            </view>
          </view>
          <view class="pillar-desc">{{item.desc}}</view>
          <view class="pillar-items">
            <view
              wx:for="{{item.items}}"
              wx:for-item="sub"
              wx:key="label"
              class="pillar-link"
              data-url="{{sub.url}}"
              bindtap="goPillar"
            >
              {{sub.label}}
              <van-icon name="arrow" size="20rpx" />
            </view>
          </view>
        </view>
      </view>

      <!-- 今日打卡 -->
      <section-title title="今日打卡" sub="Daily Check-in" more="记录" url="/pages/checkin/index" />
      <view class="card checkin-card fade-item">
        <view class="checkin-top">
          <progress-ring progress="{{checked ? 1 : 0}}" size="{{170}}" color="#B99A5B">
            <view class="ring-num">{{streak}}</view>
            <view class="ring-label">连续天数</view>
          </progress-ring>
          <view class="checkin-stats">
            <view class="stat">
              <text class="stat-num">{{totalMinutes}}</text>
              <text class="stat-label">累计分钟</text>
            </view>
            <view class="checkin-btn {{checked ? 'done' : ''}}" bindtap="doCheckin">
              {{checked ? '今日已打卡 ✓' : '打卡此刻'}}
            </view>
          </view>
        </view>
        <view class="week">
          <view wx:for="{{week}}" wx:key="label" class="week-day">
            <view class="week-dot {{item.done ? 'done' : ''}} {{item.isToday ? 'today' : ''}}">
              <van-icon wx:if="{{item.done}}" name="success" size="24rpx" color="#F7F4EE" />
            </view>
            <text class="week-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
