.home { min-height: 100vh; background: var(--beige); }

/* ---------------- Hero：整屏照片（设计稿：首屏即全幅照片） ---------------- */
.hero {
  position: relative;
  overflow: hidden;
  min-height: 100vh;
  /* 照片加载失败时的兜底底色 */
  background: linear-gradient(160deg, #24382C 0%, #203228 45%, #131F18 100%);
  box-sizing: border-box;
}

.hero-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(10, 14, 9, 0.5) 0%, rgba(10, 14, 9, 0.12) 32%, rgba(10, 14, 9, 0.3) 60%, rgba(10, 14, 9, 0.66) 100%);
}

.hero-content {
  position: relative;
  min-height: 100vh;
  padding-left: 36rpx;
  padding-right: 36rpx;
  padding-bottom: 230rpx; /* 为悬浮 TabBar 留出（设计稿 TabBar 悬浮于照片上） */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.hero-brand-name {
  color: rgba(250, 248, 242, 0.9);
  font-size: 31rpx;
  letter-spacing: 3rpx;
  font-weight: 300;
}
.hero-brand-sub {
  color: rgba(250, 248, 242, 0.6);
  font-size: 26rpx;
  letter-spacing: 5rpx;
  margin-top: 8rpx;
}

.hero-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: auto;
}

.hero-logo {
  width: 250rpx;
  height: 250rpx;
  animation: breathe 6s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { transform: scale(1); opacity: 0.95; }
  50% { transform: scale(1.05); opacity: 1; }
}

.hero-slogan {
  color: #FAF8F2;
  font-size: 80rpx;
  font-weight: 700;
  margin-top: 12rpx;
  letter-spacing: 10rpx;
  text-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.45);
}

.hero-en {
  color: rgba(250, 248, 242, 0.85);
  font-size: 30rpx;
  font-style: italic;
  font-family: Georgia, "Songti SC", serif;
  margin-top: 8rpx;
}

/* 毛玻璃卡（速览 / 禅语共用，设计稿：深色半透明 + 大圆角） */
.glass {
  margin-top: 36rpx;
  background: rgba(14, 18, 11, 0.62);
  backdrop-filter: blur(20px);
  border-radius: 36rpx;
}

/* 四支柱速览：细描边圆形图标 */
.pillars-quick {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 28rpx 36rpx;
  margin-top: 56rpx;
}
.quick {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  transition: transform 0.15s ease;
}
.quick:active { transform: scale(0.94); }
.quick-ring {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(250, 248, 242, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-label {
  color: rgba(250, 248, 242, 0.92);
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* 禅语轮播 */
.quote-glass { position: relative; padding: 48rpx 52rpx 42rpx; }
.quote-mark {
  position: absolute;
  font-size: 68rpx;
  font-family: Georgia, serif;
  color: rgba(250, 248, 242, 0.5);
  line-height: 1;
}
.qm-l { top: 30rpx; left: 36rpx; }
.qm-r { bottom: 56rpx; right: 36rpx; }

.quote-swiper { height: 210rpx; }
.quote-slide {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.quote-text {
  color: rgba(250, 248, 242, 0.94);
  font-size: 29rpx;
  line-height: 2.1;
  letter-spacing: 2rpx;
  text-align: center;
  padding: 0 16rpx;
}

.quote-dots {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  margin-top: 10rpx;
}
.qdot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: rgba(250, 248, 242, 0.32);
  transition: all 0.3s ease;
}
.qdot.on { background: rgba(250, 248, 242, 0.92); }

/* ---------------- Body ---------------- */
.body { padding: 8rpx 32rpx 220rpx; }

.sk-lg { height: 320rpx; margin-bottom: 24rpx; border-radius: var(--radius); }
.sk-md { height: 200rpx; margin: 40rpx 0 24rpx; border-radius: var(--radius); }

/* 封面照片通用（渐变兜底在下，照片在上） */
.cover { position: relative; }
.cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.cover-play { position: relative; z-index: 1; }

/* 今日冥想 */
.continue-card { display: flex; gap: 28rpx; align-items: center; }
.continue-cover {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--radius-sm);
}
.continue-info { flex: 1; display: flex; flex-direction: column; gap: 10rpx; }
.continue-btn {
  align-self: flex-start;
  margin-top: 10rpx;
  background: var(--forest);
  color: #F7F4EE;
  font-size: 25rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
}

/* 四大支柱详情卡 */
.pillars { display: flex; flex-direction: column; gap: 24rpx; }

.pillar-head { display: flex; align-items: center; gap: 20rpx; }
.pillar-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pillar-name { display: flex; flex-direction: column; }
.pillar-title { font-size: 38rpx; }
.pillar-en { font-size: 22rpx; color: var(--ink-3); letter-spacing: 2rpx; }
.pillar-desc { margin-top: 16rpx; font-size: 26rpx; color: var(--ink-2); }

.pillar-items {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}
.pillar-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--card-soft);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  transition: transform 0.15s ease;
}
.pillar-link:active { transform: scale(0.97); }

/* 打卡 */
.checkin-top { display: flex; align-items: center; gap: 40rpx; }
.ring-num { font-size: 52rpx; font-weight: 700; color: var(--ink); line-height: 1.2; }
.ring-label { font-size: 22rpx; color: var(--ink-3); }
.checkin-stats { flex: 1; display: flex; flex-direction: column; gap: 20rpx; }
.stat { display: flex; flex-direction: column; }
.stat-num { font-size: 44rpx; font-weight: 700; }
.stat-label { font-size: 23rpx; color: var(--ink-3); }
.checkin-btn {
  background: var(--gold);
  color: #FFF;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  transition: transform 0.15s ease;
}
.checkin-btn:active { transform: scale(0.97); }
.checkin-btn.done { background: var(--gold-soft); color: var(--gold); }

.week {
  display: flex;
  justify-content: space-between;
  margin-top: 36rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--line);
}
.week-day { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.week-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card-soft);
}
.week-dot.done { background: var(--sage); border-color: var(--sage); }
.week-dot.today { box-shadow: 0 0 0 4rpx var(--gold-soft); }
.week-label { font-size: 22rpx; color: var(--ink-3); }
