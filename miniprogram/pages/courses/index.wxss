.head { margin: 16rpx 8rpx 32rpx; }
.head-title { font-size: 44rpx; }

.sk-course { height: 480rpx; margin-bottom: 24rpx; border-radius: var(--radius); }

.course { padding: 0; overflow: hidden; }

.course-cover {
  height: 240rpx;
  border-radius: 0;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}
.course-order {
  color: rgba(247, 244, 238, 0.9);
  font-size: 80rpx;
  letter-spacing: 4rpx;
}
.course-diff {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(247, 244, 238, 0.2);
  backdrop-filter: blur(10px);
  color: #F7F4EE;
  font-size: 22rpx;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
}

.course-body { padding: 32rpx; }
.course-sub { margin-top: 8rpx; font-size: 25rpx; color: var(--ink-2); }

.course-tags { margin-top: 20rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.course-tag {
  font-size: 22rpx;
  color: var(--gold);
  background: var(--gold-soft);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.course-progress { display: flex; align-items: center; gap: 16rpx; margin-top: 24rpx; }
.course-progress-bar {
  flex: 1;
  height: 10rpx;
  background: var(--line);
  border-radius: 999rpx;
  overflow: hidden;
}
.course-progress-in { height: 100%; background: var(--gold); border-radius: 999rpx; }

.course-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--line);
}
.course-price-num { font-size: 40rpx; font-weight: 700; color: var(--ink); }
.course-price-unit { font-size: 23rpx; color: var(--ink-3); margin-left: 6rpx; }
.course-lock {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.course-lock.open { color: var(--gold); }

.vip-banner {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(120deg, var(--card) 0%, var(--gold-soft) 100%);
}
.vip-title { font-size: 34rpx; color: var(--gold); }
