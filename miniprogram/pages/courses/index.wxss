.head { margin: 16rpx 8rpx 32rpx; }
.head-title { font-size: 44rpx; }

.sk-course { height: 300rpx; margin-bottom: 24rpx; border-radius: var(--radius); }

/* 设计稿同款横排卡片 */
.course {
  display: flex;
  gap: 28rpx;
  padding: 28rpx;
}

.cover { position: relative; }
.cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.course-cover {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.course-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.course-order {
  font-size: 26rpx;
  color: var(--ink-3);
  letter-spacing: 2rpx;
}

.course-title {
  margin-top: 6rpx;
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1.4;
}

.course-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.course-progress { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.course-progress-bar {
  flex: 1;
  height: 8rpx;
  background: var(--line);
  border-radius: 999rpx;
  overflow: hidden;
}
.course-progress-in { height: 100%; background: var(--gold); border-radius: 999rpx; }

.course-foot {
  margin-top: auto;
  padding-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.course-price { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.course-price-unit { font-size: 22rpx; color: var(--ink-3); font-weight: 400; margin-left: 4rpx; }

.vip-banner {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(120deg, var(--card) 0%, var(--gold-soft) 100%);
}
.vip-title { font-size: 34rpx; color: var(--gold); }
