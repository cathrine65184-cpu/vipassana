<view class="page">
  <view class="head">
    <view class="head-title">付费课程</view>
    <view class="t-sub">系统学习内观与正念</view>
  </view>

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton sk-course" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </block>

  <block wx:else>
    <!-- 设计稿同款：左侧方形照片 + 右侧编号/标题/简介/价格/锁 -->
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card course fade-item"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <view class="course-cover cover {{item.cover}}">
        <image class="cover-img" src="{{item.img}}" mode="aspectFill" />
      </view>
      <view class="course-body">
        <view class="course-order">{{item.order}}</view>
        <view class="course-title">{{item.title}}</view>
        <view class="course-sub">{{item.subtitle}}</view>

        <!-- 已解锁课程显示学习进度 -->
        <view wx:if="{{item.unlocked && item.progress > 0}}" class="course-progress">
          <view class="course-progress-bar"><view class="course-progress-in" style="width:{{item.progress}}%"></view></view>
          <text class="t-hint">{{item.progress}}%</text>
        </view>

        <view class="course-foot">
          <view class="course-price">¥{{item.price}}<text class="course-price-unit">{{item.priceUnit === '元' ? '' : item.priceUnit.slice(1)}}</text></view>
          <van-icon
            name="{{item.unlocked ? 'success' : 'lock'}}"
            size="32rpx"
            color="{{item.unlocked ? '#B99A5B' : 'rgba(32,50,40,0.35)'}}"
          />
        </view>
      </view>
    </view>

    <!-- 会员横幅 -->
    <view class="card vip-banner" bindtap="goVip">
      <view>
        <view class="vip-title display">成为会员</view>
        <view class="t-hint">解锁全部课程与冥想 · 专属社区</view>
      </view>
      <van-icon name="arrow" color="#B99A5B" />
    </view>
  </block>
</view>
