<view class="page">
  <view class="head">
    <view class="head-title">文章分享 · 小圈子交流</view>
    <view class="t-sub">分享心得，彼此陪伴成长</view>
  </view>

  <!-- 排序 Tab（设计稿：推荐 / 最新 / 精华 / 我的圈子）+ 右侧搜索开关 -->
  <view class="sort">
    <view
      wx:for="{{tabs}}"
      wx:key="*this"
      class="sort-item {{tab === index ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >{{item}}</view>
    <view class="sort-search" bindtap="toggleSearch">
      <van-icon name="search" size="34rpx" color="rgba(31,41,31,0.45)" />
    </view>
  </view>

  <!-- 搜索与话题（默认收起，保持与设计稿一致的版面） -->
  <block wx:if="{{showSearch}}">
    <view class="search">
      <van-icon name="search" size="30rpx" color="rgba(31,41,31,0.35)" />
      <input
        class="search-input"
        placeholder="搜索帖子、作者"
        confirm-type="search"
        focus
        bindconfirm="onSearch"
        bindinput="onSearch"
      />
    </view>
    <scroll-view scroll-x class="tags" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{hotTags}}"
        wx:key="*this"
        class="chip {{tag === item ? 'active' : ''}}"
        data-tag="{{item}}"
        bindtap="toggleTag"
      >{{item}}</view>
    </scroll-view>
  </block>

  <!-- 骨架屏 -->
  <block wx:if="{{loading}}">
    <view class="skeleton sk-post" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
  </block>

  <!-- 单列图文流（设计稿同款：左侧文字 + 右侧方形照片） -->
  <block wx:else>
    <block wx:if="{{list.length}}">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="card post fade-item"
        data-id="{{item.id}}"
        data-mine="{{item.mine}}"
        bindtap="goDetail"
      >
        <view class="post-top">
          <view class="post-avatar {{item.avatarBg}}"></view>
          <view class="post-who">
            <view class="post-author">{{item.author}}</view>
            <view class="t-hint">{{item.time}}</view>
          </view>
          <van-icon name="ellipsis" size="34rpx" color="rgba(32,50,40,0.3)" />
        </view>

        <view class="post-main">
          <view class="post-text">
            <view class="post-title">{{item.title}}</view>
            <view class="post-excerpt">{{item.excerpt}}</view>
          </view>
          <view wx:if="{{item.cover}}" class="post-thumb cover {{item.cover}}">
            <image wx:if="{{item.img}}" class="cover-img" src="{{item.img}}" mode="aspectFill" />
          </view>
        </view>

        <view class="post-meta">
          <view class="post-act"><van-icon name="like-o" size="30rpx" />{{item.likes}}</view>
          <view class="post-act"><van-icon name="chat-o" size="30rpx" />{{item.comments.length}}</view>
        </view>
      </view>
    </block>

    <empty-state wx:else title="这里还很安静" desc="没有找到相关内容，换个关键词试试" />
  </block>

  <!-- 发帖悬浮按钮 -->
  <view class="fab" bindtap="goCreate">
    <van-icon name="plus" color="#F7F4EE" size="44rpx" />
  </view>
</view>
