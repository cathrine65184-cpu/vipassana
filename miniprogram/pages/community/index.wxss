.head { margin: 16rpx 8rpx 28rpx; }
.head-title { font-size: 42rpx; }

.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  box-shadow: var(--shadow);
}
.search-input { flex: 1; font-size: 27rpx; }

.tags { white-space: nowrap; margin-top: 28rpx; }
.tags .chip { display: inline-flex; }

.sort {
  display: flex;
  gap: 36rpx;
  margin: 12rpx 8rpx 28rpx;
}
.sort-item {
  font-size: 27rpx;
  color: var(--ink-3);
  padding-bottom: 8rpx;
  border-bottom: 4rpx solid transparent;
  transition: all 0.2s ease;
}
.sort-item.on {
  color: var(--ink);
  font-weight: 600;
  border-bottom-color: var(--gold);
}

.falls { display: flex; gap: 20rpx; }
.fall-col { flex: 1; display: flex; flex-direction: column; gap: 20rpx; min-width: 0; }

.sk-post { height: 360rpx; }
.sk-post.short { height: 240rpx; }

.post { padding: 24rpx; }
.post-cover { height: 200rpx; margin-bottom: 20rpx; }
.post-title { font-size: 28rpx; font-weight: 600; line-height: 1.5; }
.post-excerpt {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.post-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}
.post-author { display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: var(--ink-3); }
.post-avatar { width: 40rpx; height: 40rpx; border-radius: 50%; }
.g-gold { background: linear-gradient(135deg, #D9C39A, #B99A5B); }
.post-like { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: var(--ink-3); }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--forest);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(32, 50, 40, 0.3);
  z-index: 90;
  transition: transform 0.15s ease;
}
.fab:active { transform: scale(0.92); }
