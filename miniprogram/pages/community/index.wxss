.head { margin: 16rpx 8rpx 28rpx; }
.head-title { font-size: 42rpx; }

.search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  box-shadow: var(--shadow);
}
.search-input { flex: 1; font-size: 27rpx; }

.sort {
  display: flex;
  gap: 36rpx;
  margin: 32rpx 8rpx 8rpx;
}
.sort-item {
  font-size: 27rpx;
  color: var(--ink-3);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}
.sort-item.on {
  color: var(--forest);
  font-weight: 600;
  background: var(--gold-soft);
}

.tags { white-space: nowrap; margin: 16rpx 0 8rpx; }
.tags .chip { display: inline-flex; }

.sk-post { height: 300rpx; margin-top: 20rpx; border-radius: var(--radius); }

/* 设计稿同款帖子卡：作者行 + 左文右图 + 互动行 */
.post { margin-top: 20rpx; padding: 28rpx; }

.post-top { display: flex; align-items: center; gap: 16rpx; }
.post-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0; }
.g-gold { background: linear-gradient(135deg, #D9C39A, #B99A5B); }
.post-who { flex: 1; }
.post-author { font-size: 27rpx; font-weight: 600; }

.post-main { display: flex; gap: 24rpx; margin-top: 20rpx; }
.post-text { flex: 1; min-width: 0; }
.post-title { font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.post-excerpt {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  line-height: 1.8;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.cover { position: relative; }
.cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.post-thumb {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  overflow: hidden;
}

.post-meta {
  display: flex;
  gap: 40rpx;
  margin-top: 22rpx;
}
.post-act {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--forest);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(32, 50, 40, 0.3);
  z-index: 90;
  transition: transform 0.15s ease;
}
.fab:active { transform: scale(0.92); }
