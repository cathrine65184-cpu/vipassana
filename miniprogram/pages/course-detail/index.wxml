<view class="page" wx:if="{{course}}">

  <!-- 封面 -->
  <view class="hero cover {{course.cover}}">
    <image class="hero-img" src="{{course.img}}" mode="aspectFill" />
    <view class="hero-shade"></view>
    <text class="hero-order display">{{course.order}}</text>
    <view class="hero-title display">{{course.title}}</view>
    <view class="hero-sub">{{course.subtitle}}</view>
    <view class="hero-diff">{{course.difficulty}}</view>
  </view>

  <!-- 简介 -->
  <view class="card">
    <view class="t-title">课程介绍</view>
    <view class="desc">{{course.desc}}</view>
    <view class="teachers">
      <view wx:for="{{course.teachers}}" wx:key="*this" class="teacher">
        <van-icon name="user-circle-o" size="30rpx" color="#B99A5B" />
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 包含内容 -->
  <view class="card">
    <view class="t-title">课程包含</view>
    <view wx:for="{{course.includes}}" wx:key="*this" class="row">
      <van-icon name="success" size="26rpx" color="#B99A5B" />
      <text>{{item}}</text>
    </view>
  </view>

  <!-- 适合人群 -->
  <view class="card">
    <view class="t-title">适合人群</view>
    <view wx:for="{{course.audience}}" wx:key="*this" class="row">
      <van-icon name="flower-o" size="26rpx" color="#B99A5B" />
      <text>{{item}}</text>
    </view>
  </view>

  <!-- 章节 -->
  <view class="card">
    <view class="chapter-head">
      <view class="t-title">章节目录</view>
      <text class="t-hint">{{doneCount}}/{{chapters.length}} 已完成</text>
    </view>
    <view
      wx:for="{{chapters}}"
      wx:key="id"
      class="chapter {{item.locked ? 'locked' : ''}}"
      data-id="{{item.id}}"
      data-locked="{{item.locked}}"
      data-done="{{item.done}}"
      data-type="{{item.type}}"
      data-resource-key="{{item.resourceKey}}"
      data-article-id="{{item.articleId}}"
      bindtap="tapChapter"
    >
      <view class="chapter-icon {{item.done ? 'done' : ''}}">
        <van-icon name="{{item.done ? 'success' : item.meta.icon}}" size="30rpx" />
      </view>
      <view class="chapter-info">
        <view class="chapter-title">{{item.title}}</view>
        <view class="t-hint">{{item.meta.label}} · {{item.duration}}<text wx:if="{{item.free}}" class="free-tag">试学</text></view>
      </view>
      <van-icon wx:if="{{item.locked}}" name="lock" size="30rpx" color="#B99A5B" />
      <van-icon wx:else name="arrow" size="26rpx" color="rgba(32,50,40,0.3)" />
    </view>
  </view>

  <!-- 咨询产品购买后显示本人微信二维码；原图可长按保存或点击查看 -->
  <view class="card contact-card" wx:if="{{unlocked && (course.id === 'one2one' || course.id === 'group')}}">
    <view class="contact-head">
      <view>
        <view class="t-title">添加导师微信</view>
        <view class="t-hint">购买成功后，请扫码添加 Drake 导师预约咨询</view>
      </view>
      <van-icon name="qr" size="44rpx" color="#A68F55" />
    </view>
    <view class="qr-window" bindtap="previewWechat">
      <image class="qr-source" src="/assets/wechat-contact.jpg" mode="widthFix" show-menu-by-longpress />
    </view>
    <view class="btn btn-secondary contact-btn" bindtap="previewWechat">查看完整二维码</view>
    <view class="privacy-note">二维码仅对已购用户显示，请勿公开转发。</view>
  </view>

  <!-- 完课徽章 -->
  <view class="card badge-card" wx:if="{{badgeEarned}}">
    <van-icon name="medal-o" size="56rpx" color="#B99A5B" />
    <view>
      <view class="t-title t-gold">徽章「{{course.badge}}」已点亮</view>
      <view class="t-hint">完成全部章节 · 愿你安住</view>
    </view>
  </view>

  <!-- 底部购买栏 -->
  <view class="buybar safe-bottom" wx:if="{{!unlocked}}">
    <view class="buybar-price">
      <text class="buybar-num">¥{{course.price}}</text>
      <text class="buybar-unit">{{course.priceUnit}}</text>
      <view wx:if="{{course.priceNote}}" class="t-hint">{{course.priceNote}}</view>
    </view>
    <view class="btn btn-primary buybar-btn" bindtap="buy">立即解锁</view>
  </view>
</view>
