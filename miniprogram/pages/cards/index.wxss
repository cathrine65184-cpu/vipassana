.cards-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx 0 80rpx;
  box-sizing: border-box;
}

.head { text-align: center; }
.head-title { font-size: 42rpx; }

.swiper { height: 780rpx; margin-top: 48rpx; }

.wcard {
  height: 720rpx;
  margin: 20rpx 20rpx 0;
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  box-sizing: border-box;
  transform: scale(0.92);
  opacity: 0.7;
  transition: all 0.35s ease;
  box-shadow: 0 24rpx 64rpx rgba(32, 50, 40, 0.22);
}
.wcard.on { transform: scale(1); opacity: 1; }

.wcard-logo { width: 120rpx; height: 120rpx; opacity: 0.85; }
.wcard-text {
  margin-top: 56rpx;
  color: #F7F4EE;
  font-size: 42rpx;
  line-height: 2;
  text-align: center;
  white-space: pre-line;
}
.wcard-from {
  margin-top: 40rpx;
  color: rgba(247, 244, 238, 0.65);
  font-size: 25rpx;
}

.dots { display: flex; justify-content: center; gap: 12rpx; margin-top: 32rpx; }
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--line);
  transition: all 0.3s ease;
}
.dot.on { width: 36rpx; background: var(--gold); }

.acts { display: flex; justify-content: center; gap: 100rpx; margin-top: 48rpx; }
.act {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: var(--ink-2);
  background: transparent;
  border: none;
  padding: 0;
  line-height: inherit;
}
.act.share::after { border: none; }
