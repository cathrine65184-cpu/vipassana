.player-page { min-height: 100vh; background: #101711; color: #F7F4EE; }
.video-shell { width: 100%; aspect-ratio: 16 / 10; background: #0A0D0A; }
.course-video { width: 100%; height: 100%; }
.state-panel {
  width: 100%; height: 100%; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 20rpx; padding: 50rpx;
  box-sizing: border-box; color: rgba(247,244,238,.72); font-size: 25rpx;
}
.state-title { color: #F7F4EE; font-size: 32rpx; font-weight: 600; }
.state-desc { max-width: 560rpx; text-align: center; line-height: 1.8; }
.course-meta { padding: 42rpx 40rpx; }
.course-title { font-size: 36rpx; font-weight: 600; line-height: 1.5; }
.course-duration { margin-top: 12rpx; color: rgba(247,244,238,.46); font-size: 25rpx; }
.notice { margin-top: 46rpx; padding: 24rpx; border-radius: 20rpx; background: rgba(255,255,255,.05); color: rgba(247,244,238,.42); font-size: 22rpx; line-height: 1.8; }
.spin { animation: spin 1.2s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
