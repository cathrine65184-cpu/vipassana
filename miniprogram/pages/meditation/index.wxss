.head { margin: 16rpx 8rpx 28rpx; }
.head-title { font-size: 42rpx; font-weight: 700; letter-spacing: 2rpx; }
.head .t-sub { margin-top: 10rpx; }

.sk-hero { height: 480rpx; border-radius: var(--radius); margin-bottom: 24rpx; }
.sk-row { height: 160rpx; border-radius: var(--radius); }

/* 封面照片通用 */
.cover { position: relative; }
.cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* ===== 内嵌播放卡（设计稿） ===== */
.player-card {
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow);
}
.player-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(14, 21, 17, 0.35) 0%, rgba(14, 21, 17, 0.78) 100%);
}
.player-inner { position: relative; padding: 36rpx 36rpx 28rpx; }

.player-head { display: flex; align-items: center; justify-content: space-between; }
.player-title { color: #F7F4EE; font-size: 40rpx; }
.player-sub { color: rgba(247, 244, 238, 0.72); font-size: 24rpx; margin-top: 8rpx; }

.player-track {
  position: relative;
  height: 8rpx;
  background: rgba(247, 244, 238, 0.25);
  border-radius: 999rpx;
  margin-top: 90rpx;
}
.player-track-in { height: 100%; background: #F7F4EE; border-radius: 999rpx; }
.player-knob {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #F7F4EE;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
.player-times { color: rgba(247, 244, 238, 0.65); font-size: 22rpx; margin-top: 14rpx; }

.player-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 90rpx;
  margin-top: 28rpx;
}

/* ⏮ / ⏭ 跳转图标（CSS 绘制，白描边风格） */
.skip { display: flex; align-items: center; gap: 4rpx; padding: 16rpx; }
.skip-bar {
  width: 6rpx;
  height: 30rpx;
  border-radius: 3rpx;
  background: rgba(250, 248, 242, 0.88);
}
.skip-tri { width: 0; height: 0; border-top: 16rpx solid transparent; border-bottom: 16rpx solid transparent; }
.skip-tri.left { border-right: 24rpx solid rgba(250, 248, 242, 0.88); }
.skip-tri.right { border-left: 24rpx solid rgba(250, 248, 242, 0.88); }
.player-play {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(247, 244, 238, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}
.player-play:active { transform: scale(0.94); }

.player-tools {
  display: flex;
  justify-content: space-between;
  margin-top: 36rpx;
  padding: 0 20rpx;
}
.ptool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: rgba(247, 244, 238, 0.8);
  font-size: 22rpx;
}

/* ===== 今日打卡 / 打卡记录 ===== */
.checkin { margin-top: 24rpx; }
.checkin-head { display: flex; align-items: center; justify-content: space-between; }

.week {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}
.week-day { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.week-dot {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  background: var(--card-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.week-dot.done { background: var(--sage); border-color: var(--sage); }
.week-dot.today { box-shadow: 0 0 0 4rpx var(--gold-soft); }
.week-label { font-size: 22rpx; color: var(--ink-3); }

.record-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}
.record-row {
  display: flex;
  align-items: flex-end;
  gap: 48rpx;
  margin-top: 28rpx;
}
.record-stat { display: flex; flex-direction: column; gap: 8rpx; }
.record-num { font-size: 44rpx; font-weight: 700; }
.record-unit { font-size: 22rpx; font-weight: 400; color: var(--ink-3); }
.record-bars {
  margin-left: auto;
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
  height: 88rpx;
}
.rbar {
  width: 16rpx;
  background: var(--gold);
  border-radius: 999rpx;
  opacity: 0.85;
}

/* 模式入口 */
.modes { display: flex; gap: 20rpx; margin-top: 24rpx; }
.mode { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; padding: 36rpx 24rpx; }
.mode-name { font-size: 28rpx; font-weight: 600; }

/* 情绪 */
.emo-list { display: flex; justify-content: space-between; }
.emo {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  border-radius: var(--radius-sm);
  transition: all 0.2s ease;
}
.emo.on { background: var(--gold-soft); transform: translateY(-4rpx); }
.emo-emoji { font-size: 44rpx; }
.emo-label { font-size: 22rpx; color: var(--ink-2); }

.emo-reply { margin-top: 28rpx; padding-top: 28rpx; border-top: 2rpx solid var(--line); }
.emo-reply-text { font-size: 27rpx; color: var(--ink-2); line-height: 1.9; }
.emo-reco {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--card-soft);
  border: 2rpx solid var(--line);
  border-radius: var(--radius-sm);
  padding: 20rpx;
}
.emo-reco-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}
.emo-reco-info { flex: 1; }
.emo-reco-title { font-size: 26rpx; font-weight: 600; }

/* 分类 */
.cats { white-space: nowrap; }
.cats .chip { display: inline-flex; }

.med-list { margin-top: 8rpx; }
.med { display: flex; gap: 24rpx; align-items: center; }
.med-cover {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: var(--radius-sm);
}
.med-play { position: relative; z-index: 1; }
.med-info { flex: 1; min-width: 0; }
.med-title { font-size: 29rpx; font-weight: 600; }
.vip-tag {
  margin-left: 12rpx;
  font-size: 18rpx;
  color: var(--gold);
  border: 2rpx solid var(--gold);
  padding: 0 10rpx;
  border-radius: 999rpx;
  vertical-align: 4rpx;
}
.med-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
