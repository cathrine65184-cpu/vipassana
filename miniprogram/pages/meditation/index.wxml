<view class="page">
  <view class="head">
    <view class="head-title display">冥想音频 · 每日打卡</view>
    <view class="t-sub">每日练习，培养正念习惯</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="skeleton sk-hero"></view>
    <view class="skeleton sk-row"></view>
  </block>

  <block wx:else>
    <!-- ===== 内嵌播放卡（设计稿同款） ===== -->
    <view class="player-card cover {{continueItem.cover}}">
      <image class="cover-img" src="{{continueItem.img}}" mode="aspectFill" />
      <view class="player-shade"></view>

      <view class="player-inner">
        <view class="player-head" bindtap="openPlayer">
          <view>
            <view class="player-title display">{{continueItem.title}}</view>
            <view class="player-sub">{{continueItem.minutes}} 分钟</view>
          </view>
          <van-icon name="arrow" color="rgba(247,244,238,0.7)" size="30rpx" />
        </view>

        <!-- 进度 -->
        <view class="player-track">
          <view class="player-track-in" style="width:{{percent}}%"></view>
          <view class="player-knob" style="left:{{percent}}%"></view>
        </view>
        <view class="player-times">{{curText}} / {{totalText}}</view>

        <!-- 控制 -->
        <view class="player-controls">
          <van-icon name="arrow-left" size="44rpx" color="rgba(247,244,238,0.85)" bindtap="openPlayer" />
          <view class="player-play" bindtap="openPlayer">
            <van-icon name="play" size="44rpx" color="#F7F4EE" />
          </view>
          <van-icon name="arrow" size="44rpx" color="rgba(247,244,238,0.85)" bindtap="openPlayer" />
        </view>

        <!-- 工具行：列表 / 定时 / 下载 / 收藏 -->
        <view class="player-tools">
          <view class="ptool" bindtap="openPlayer"><van-icon name="bars" size="38rpx" /><text>列表</text></view>
          <view class="ptool" bindtap="openPlayer"><van-icon name="underway-o" size="38rpx" /><text>定时</text></view>
          <view class="ptool" bindtap="openPlayer"><van-icon name="down" size="38rpx" /><text>下载</text></view>
          <view class="ptool" bindtap="openPlayer"><van-icon name="like-o" size="38rpx" /><text>收藏</text></view>
        </view>
      </view>
    </view>

    <!-- ===== 今日打卡（设计稿同款） ===== -->
    <view class="card checkin">
      <view class="checkin-head">
        <view class="t-title">今日打卡</view>
        <view class="t-hint">已连续打卡 {{streak}} 天</view>
      </view>
      <view class="week">
        <view wx:for="{{week}}" wx:key="label" class="week-day">
          <view class="week-dot {{item.done ? 'done' : ''}} {{item.isToday ? 'today' : ''}}">
            <van-icon wx:if="{{item.done}}" name="success" size="24rpx" color="#F7F4EE" />
          </view>
          <text class="week-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- ===== 打卡记录（设计稿同款） ===== -->
    <view class="card record">
      <view class="checkin-head">
        <view class="t-title">打卡记录</view>
        <view class="record-more" bindtap="goCheckin">查看全部 <van-icon name="arrow" size="22rpx" /></view>
      </view>
      <view class="record-row">
        <view class="record-stat">
          <view class="t-hint">总天数</view>
          <view class="record-num">{{totalDays}} <text class="record-unit">天</text></view>
        </view>
        <view class="record-stat">
          <view class="t-hint">总时长</view>
          <view class="record-num">{{totalHours}} <text class="record-unit">小时</text> {{totalMinutesRemain}} <text class="record-unit">分钟</text></view>
        </view>
        <view class="record-bars">
          <view wx:for="{{weekBars}}" wx:key="id" class="rbar" style="height:{{item.height}}%"></view>
        </view>
      </view>
    </view>

    <!-- ===== 特殊模式 ===== -->
    <view class="modes">
      <view class="mode card" bindtap="goSilent">
        <van-icon name="closed-eye" size="44rpx" color="#B99A5B" />
        <view class="mode-name">静默模式</view>
        <view class="t-hint">只有呼吸与计时</view>
      </view>
      <view class="mode card" bindtap="goRetreat">
        <van-icon name="shrink" size="44rpx" color="#B99A5B" />
        <view class="mode-name">禅修营模式</view>
        <view class="t-hint">十日内观日程</view>
      </view>
    </view>

    <!-- ===== 情绪识别（AI） ===== -->
    <section-title title="此刻的心情" sub="AI Emotion Check-in" />
    <view class="card">
      <view class="emo-list">
        <view
          wx:for="{{emotions}}"
          wx:key="id"
          class="emo {{pickedEmotion.id === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="pickEmotion"
        >
          <text class="emo-emoji">{{item.emoji}}</text>
          <text class="emo-label">{{item.label}}</text>
        </view>
      </view>
      <view wx:if="{{pickedEmotion}}" class="emo-reply">
        <view class="emo-reply-text">{{pickedEmotion.reply}}</view>
        <view class="emo-reco" data-id="{{recommend.id}}" bindtap="goPlay">
          <view class="emo-reco-cover cover {{recommend.cover}}">
            <image class="cover-img" src="{{recommend.img}}" mode="aspectFill" />
          </view>
          <view class="emo-reco-info">
            <view class="emo-reco-title">为你推荐：{{recommend.title}}</view>
            <view class="t-hint">{{recommend.minutes}} 分钟 · {{recommend.category}}</view>
          </view>
          <van-icon name="arrow" size="26rpx" color="rgba(32,50,40,0.3)" />
        </view>
      </view>
    </view>

    <!-- ===== 分类 ===== -->
    <section-title title="冥想分类" sub="音频陆续上架中" />
    <scroll-view scroll-x class="cats" enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="chip {{cat === item ? 'active' : ''}}"
        data-cat="{{item}}"
        bindtap="pickCat"
      >{{item}}</view>
    </scroll-view>

    <view class="med-list">
      <view
        wx:for="{{list}}"
        wx:key="id"
        class="card med fade-item"
        data-id="{{item.id}}"
        bindtap="goPlay"
      >
        <view class="med-cover cover {{item.cover}}">
          <image class="cover-img" src="{{item.img}}" mode="aspectFill" />
          <van-icon name="play" color="#F7F4EE" size="36rpx" class="med-play" />
        </view>
        <view class="med-info">
          <view class="med-title">{{item.title}}<text wx:if="{{item.vip}}" class="vip-tag">VIP</text></view>
          <view class="t-hint">{{item.minutes}} 分钟 · {{item.category}}</view>
          <view class="med-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
