<view class="player" wx:if="{{med}}">

  <!-- 封面 -->
  <view class="stage">
    <view class="disc cover {{med.cover}} {{playing ? 'spin' : ''}}">
      <image class="disc-img" src="{{med.img}}" mode="aspectFill" />
      <view class="disc-shade"></view>
      <image class="disc-logo" src="/assets/logo-white.png" mode="aspectFit" />
    </view>
    <view class="med-title display">{{med.title}}</view>
    <view class="med-sub">{{med.minutes}} 分钟 · {{med.category}}</view>
    <view class="med-desc">{{med.desc}}</view>
  </view>

  <!-- 进度 -->
  <view class="progress">
    <slider
      class="slider"
      value="{{percent}}"
      activeColor="#B99A5B"
      backgroundColor="rgba(247,244,238,0.2)"
      block-size="18"
      block-color="#F7F4EE"
      bindchange="onSlider"
    />
    <view class="times">
      <text>{{currentText}}</text>
      <text>{{totalText}}</text>
    </view>
  </view>

  <!-- 主控制 -->
  <view class="controls">
    <view class="ctrl" data-delta="-15" bindtap="seekBy">
      <van-icon name="replay" size="52rpx" color="rgba(247,244,238,0.85)" />
      <text class="ctrl-label">-15s</text>
    </view>
    <view class="play-btn" bindtap="toggle">
      <van-icon name="{{playing ? 'pause' : 'play'}}" size="56rpx" color="#203228" />
    </view>
    <view class="ctrl" data-delta="15" bindtap="seekBy">
      <van-icon name="replay" size="52rpx" color="rgba(247,244,238,0.85)" class="flip" />
      <text class="ctrl-label">+15s</text>
    </view>
  </view>

  <!-- 功能栏 -->
  <view class="tools">
    <view class="tool {{showPanel === 'speed' ? 'on' : ''}}" data-panel="speed" bindtap="openPanel">
      <van-icon name="clock-o" size="40rpx" />
      <text>{{speed}}x</text>
    </view>
    <view class="tool {{sleepTimer ? 'on' : ''}}" data-panel="timer" bindtap="openPanel">
      <van-icon name="underway-o" size="40rpx" />
      <text>{{sleepTimer ? sleepTimer + '分' : '定时'}}</text>
    </view>
    <view class="tool {{bgSound !== '无' ? 'on' : ''}}" data-panel="bg" bindtap="openPanel">
      <van-icon name="music-o" size="40rpx" />
      <text>{{bgSound === '无' ? '背景音' : bgSound}}</text>
    </view>
    <view class="tool {{loop ? 'on' : ''}}" bindtap="toggleLoop">
      <van-icon name="exchange" size="40rpx" />
      <text>循环</text>
    </view>
    <view class="tool {{downloaded ? 'on' : ''}}" bindtap="download">
      <van-icon name="down" size="40rpx" />
      <text>下载</text>
    </view>
    <view class="tool {{favorite ? 'on' : ''}}" bindtap="toggleFavorite">
      <van-icon name="{{favorite ? 'like' : 'like-o'}}" size="40rpx" />
      <text>收藏</text>
    </view>
  </view>

  <!-- 弹出面板 -->
  <view wx:if="{{showPanel === 'speed'}}" class="panel">
    <view wx:for="{{speeds}}" wx:key="*this" class="panel-item {{speed === item ? 'on' : ''}}" data-v="{{item}}" bindtap="pickSpeed">{{item}}x</view>
  </view>
  <view wx:if="{{showPanel === 'timer'}}" class="panel">
    <view wx:for="{{timerOptions}}" wx:key="*this" class="panel-item {{sleepTimer === item ? 'on' : ''}}" data-v="{{item}}" bindtap="pickTimer">{{item === 0 ? '关闭' : item + ' 分钟'}}</view>
  </view>
  <view wx:if="{{showPanel === 'bg'}}" class="panel">
    <view wx:for="{{bgSounds}}" wx:key="*this" class="panel-item {{bgSound === item ? 'on' : ''}}" data-v="{{item}}" bindtap="pickBg">{{item}}</view>
  </view>

  <view class="tip" wx:if="{{!med.audio}}">演示模式：接入音频资源后将真实播放</view>
</view>
