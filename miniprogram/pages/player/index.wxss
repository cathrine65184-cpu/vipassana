page {
  background: linear-gradient(170deg, #24382C 0%, #203228 50%, #131F18 100%);
}

.player {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 48rpx 80rpx;
  box-sizing: border-box;
}

/* 封面 */
.stage { display: flex; flex-direction: column; align-items: center; text-align: center; }
.disc {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.35), inset 0 0 0 16rpx rgba(247, 244, 238, 0.06);
}
.disc-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.disc-shade {
  position: absolute;
  inset: 0;
  background: rgba(14, 21, 17, 0.42);
}
.disc.spin { animation: spin 24s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.disc-logo { position: relative; width: 200rpx; height: 200rpx; opacity: 0.9; }

.med-title { color: #F7F4EE; font-size: 44rpx; margin-top: 48rpx; }
.med-sub { color: rgba(247, 244, 238, 0.6); font-size: 25rpx; margin-top: 10rpx; }
.med-desc { color: rgba(247, 244, 238, 0.45); font-size: 24rpx; margin-top: 16rpx; line-height: 1.8; }

/* 进度 */
.progress { width: 100%; margin-top: 56rpx; }
.slider { margin: 0; }
.times {
  display: flex;
  justify-content: space-between;
  color: rgba(247, 244, 238, 0.55);
  font-size: 22rpx;
  margin-top: 4rpx;
  padding: 0 8rpx;
}

/* 主控制 */
.controls {
  display: flex;
  align-items: center;
  gap: 80rpx;
  margin-top: 40rpx;
}
.ctrl { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.ctrl-label { color: rgba(247, 244, 238, 0.5); font-size: 20rpx; }
.flip { transform: scaleX(-1); display: inline-block; }
.play-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #F7F4EE;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.3);
  transition: transform 0.15s ease;
}
.play-btn:active { transform: scale(0.94); }

/* 功能栏 */
.tools {
  display: flex;
  justify-content: space-between;
  width: 100%;
  margin-top: 64rpx;
}
.tool {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  color: rgba(247, 244, 238, 0.6);
  font-size: 21rpx;
  flex: 1;
}
.tool.on { color: #B99A5B; }

/* 面板 */
.panel {
  margin-top: 36rpx;
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
  justify-content: center;
  background: rgba(247, 244, 238, 0.08);
  border-radius: var(--radius);
  padding: 24rpx;
  animation: page-in 0.3s ease both;
}
.panel-item {
  color: rgba(247, 244, 238, 0.7);
  font-size: 26rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(247, 244, 238, 0.2);
}
.panel-item.on { background: #B99A5B; border-color: #B99A5B; color: #FFF; }

.tip {
  margin-top: 48rpx;
  color: rgba(247, 244, 238, 0.35);
  font-size: 22rpx;
}
