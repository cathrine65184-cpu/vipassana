.hero { display: flex; flex-direction: column; align-items: center; padding: 32rpx 0 48rpx; }
.hero-logo { width: 140rpx; height: 140rpx; }
.hero-title { font-size: 44rpx; margin-top: 16rpx; color: var(--gold); }

.benefit { display: flex; align-items: center; gap: 24rpx; margin-top: 32rpx; }
.benefit-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.benefit-title { font-size: 29rpx; font-weight: 600; }

.plans { display: flex; gap: 20rpx; margin-top: 24rpx; }
.plan {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 16rpx;
  position: relative;
  border: 3rpx solid transparent;
  transition: all 0.2s ease;
}
.plan.on { border-color: var(--gold); transform: translateY(-8rpx); }
.plan-hot {
  position: absolute;
  top: -16rpx;
  background: var(--gold);
  color: #FFF;
  font-size: 20rpx;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
}
.plan-name { font-size: 26rpx; color: var(--ink-2); }
.plan-price { font-size: 56rpx; font-weight: 700; margin-top: 12rpx; }
.plan-cny { font-size: 26rpx; font-weight: 400; }
.plan-unit { font-size: 22rpx; color: var(--ink-3); }
.plan-note { margin-top: 12rpx; font-size: 20rpx; color: var(--gold); text-align: center; }

.subscribe { margin-top: 48rpx; }
.already {
  margin-top: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: var(--gold);
  font-size: 28rpx;
}
.terms { text-align: center; margin-top: 24rpx; }
