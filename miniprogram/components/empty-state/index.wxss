.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
  text-align: center;
}
.empty-icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--gold-soft, #EFE6D3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.empty-title { font-size: 30rpx; font-weight: 600; color: var(--ink, #203228); }
.empty-desc { margin-top: 12rpx; font-size: 25rpx; color: var(--ink-3, rgba(32,50,40,0.38)); }
