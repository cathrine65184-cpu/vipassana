<view class="bar-wrap">
  <view class="bar">
    <view
      wx:for="{{list}}"
      wx:key="path"
      class="bar-item {{active === index ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <!-- 激活态：绿色圆角方块 + 白色图标（设计稿同款） -->
      <view class="bar-icon {{active === index ? 'on' : ''}}">
        <van-icon
          name="{{item.icon}}"
          size="40rpx"
          color="{{active === index ? '#F7F4EE' : 'rgba(31,41,31,0.55)'}}"
        />
      </view>
      <text class="bar-text">{{item.text}}</text>
    </view>
  </view>
</view>
