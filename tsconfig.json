{
  "compilerOptions": {
    "target": "ES2018",
    "module": "CommonJS",
    "strict": true,
    "noImplicitAny": false,
    "removeComments": false,
    "skipLibCheck": true,
    "typeRoots": ["./miniprogram/typings"]
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules", "miniprogram/node_modules", "miniprogram/miniprogram_npm"]
}
